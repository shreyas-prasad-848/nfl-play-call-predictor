  <diagram id="nfl-mvp" name="NFL Play-Call Predictor MVP">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="NFL Play-Call Predictor — MVP System Diagram" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=28;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="A minimal, local machine-learning pipeline using one season and three pre-snap features" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=16;fontColor=#526079;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="&lt;b&gt;START&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Run the Python program&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DDF4E6;strokeColor=#2E8B57;strokeWidth=3;fontSize=18;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="575" y="125" width="450" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="load" value="&lt;b&gt;Load NFL Data&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;nflreadpy downloads one season of play-by-play data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=3;fontSize=18;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="700" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="clean" value="&lt;b&gt;Clean and Filter Plays&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Keep valid run/pass plays and remove missing values&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=3;fontSize=18;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="440" width="700" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="features" value="&lt;b&gt;Prepare Features and Target&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Down • yards to go • field position → run or pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=3;fontSize=18;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="610" width="700" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="split" value="&lt;b&gt;Split the Dataset&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Training plays and held-out testing plays&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=3;fontSize=18;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="780" width="700" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="baseline" value="&lt;b&gt;Baseline&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Always predict the most common play&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D7;strokeColor=#C77700;strokeWidth=3;fontSize=17;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="1010" width="420" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;Train Logistic Regression&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Learn run/pass probabilities from training plays&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E6;strokeColor=#2E8B57;strokeWidth=3;fontSize=17;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="590" y="1010" width="420" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;Evaluate and Predict&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526079&quot;&gt;Compare accuracy with baseline&lt;br&gt;Predict a user-entered situation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=3;fontSize=17;fontColor=#172033;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1010" width="420" height="115" as="geometry"/>
