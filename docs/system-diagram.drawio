        <mxCell id="e4" value="X features + y target" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#64748B;fontSize=14;fontStyle=1;fontColor=#526079;labelBackgroundColor=#F7F9FC;" edge="1" parent="1" source="features" target="split"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="training labels" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#64748B;fontSize=14;fontStyle=1;fontColor=#526079;labelBackgroundColor=#F7F9FC;" edge="1" parent="1" source="split" target="baseline"><mxGeometry relative="1" as="geometry"/></mxCell>
